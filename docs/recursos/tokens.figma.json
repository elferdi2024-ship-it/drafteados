{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "Drafteados Design Tokens",
  "version": "1.0.0",
  "description": "Figma-aligned tokens for Drafteados Awwwards redesign. Modes: light | dark.",
  "primitives": {
    "color": {
      "orange": {
        "50": "#FFF7ED",
        "100": "#FFEDD5",
        "200": "#FED7AA",
        "300": "#FDBA74",
        "400": "#FB923C",
        "500": "#F97316",
        "600": "#EA580C",
        "700": "#C2410C",
        "900": "#7C2D12"
      },
      "coral": {
        "500": "#FF5A1F",
        "600": "#E04810"
      },
      "neutral": {
        "0": "#FFFFFF",
        "50": "#FAFAFA",
        "100": "#F5F5F5",
        "200": "#E5E5E5",
        "300": "#D4D4D4",
        "400": "#A3A3A3",
        "500": "#737373",
        "600": "#525252",
        "700": "#404040",
        "750": "#303030",
        "800": "#262626",
        "850": "#1C1C1E",
        "900": "#171717",
        "950": "#0D0D0E",
        "1000": "#0A0A0A"
      },
      "live-green": "#16A34A",
      "live-green-glow": "rgba(22, 163, 74, 0.25)",
      "loss-red": "#DC2626",
      "loss-red-soft": "rgba(220, 38, 38, 0.12)",
      "east-blue": { "light": "#2563EB", "dark": "#3B82F6" },
      "west-purple": { "light": "#9333EA", "dark": "#A855F7" }
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "20": "80px",
      "24": "96px",
      "32": "128px"
    },
    "radius": {
      "none": "0px",
      "xs": "4px",
      "sm": "8px",
      "md": "12px",
      "lg": "16px",
      "xl": "24px",
      "full": "9999px"
    }
  },
  "semantic": {
    "light": {
      "bg": {
        "canvas": "#FAFAFA",
        "surface-1": "#FFFFFF",
        "surface-2": "#F5F5F5",
        "surface-3": "#E5E5E5"
      },
      "border": {
        "subtle": "rgba(0,0,0,0.08)",
        "strong": "#D4D4D4",
        "accent": "#F97316"
      },
      "text": {
        "primary": "#0A0A0A",
        "secondary": "#404040",
        "muted": "#737373",
        "dim": "#A3A3A3"
      },
      "brand": {
        "primary": "#F97316",
        "hover": "#EA580C",
        "soft": "#FFF7ED"
      },
      "state": {
        "live": "#16A34A",
        "live-soft": "rgba(22, 163, 74, 0.12)",
        "win": "#16A34A",
        "loss": "#DC2626"
      }
    },
    "dark": {
      "bg": {
        "canvas": "#0A0A0A",
        "surface-1": "#171717",
        "surface-2": "#262626",
        "surface-3": "#303030"
      },
      "border": {
        "subtle": "rgba(255,255,255,0.08)",
        "strong": "#404040",
        "accent": "#F97316"
      },
      "text": {
        "primary": "#FAFAFA",
        "secondary": "#D4D4D4",
        "muted": "#A3A3A3",
        "dim": "#737373"
      },
      "brand": {
        "primary": "#F97316",
        "hover": "#EA580C",
        "soft": "rgba(249, 115, 22, 0.15)"
      },
      "state": {
        "live": "#16A34A",
        "live-soft": "rgba(22, 163, 74, 0.20)",
        "win": "#16A34A",
        "loss": "#DC2626"
      }
    }
  },
  "typography": {
    "families": {
      "display": "Bebas Neue",
      "displayAlternates": ["Clash Display", "Syne"],
      "sans": "Plus Jakarta Sans",
      "sansAlternate": "Inter",
      "mono": "JetBrains Mono",
      "monoAlternate": "Geist Mono"
    },
    "styles": {
      "Display/Hero": { "family": "display", "weight": 400, "size": "72px", "lineHeight": 0.9, "letterSpacing": "0.04em", "case": "uppercase" },
      "Display/1": { "family": "display", "weight": 400, "size": "48px", "lineHeight": 0.95, "letterSpacing": "0.03em", "case": "uppercase" },
      "Display/2": { "family": "display", "weight": 400, "size": "32px", "lineHeight": 1.0, "letterSpacing": "0.02em", "case": "uppercase" },
      "Heading/1": { "family": "sans", "weight": 700, "size": "24px", "lineHeight": 1.2, "letterSpacing": "-0.02em" },
      "Heading/2": { "family": "sans", "weight": 600, "size": "20px", "lineHeight": 1.25, "letterSpacing": "-0.015em" },
      "Heading/3": { "family": "sans", "weight": 600, "size": "16px", "lineHeight": 1.3, "letterSpacing": "-0.01em" },
      "Body/Large": { "family": "sans", "weight": 400, "size": "16px", "lineHeight": 1.5 },
      "Body/Default": { "family": "sans", "weight": 400, "size": "14px", "lineHeight": 1.45 },
      "Body/Small": { "family": "sans", "weight": 500, "size": "12px", "lineHeight": 1.4, "letterSpacing": "0.01em" },
      "Stat/Score": { "family": "mono", "weight": 700, "size": "32px", "lineHeight": 1.0, "letterSpacing": "-0.04em", "variantNumeric": "tabular-nums" },
      "Stat/Value": { "family": "mono", "weight": 600, "size": "18px", "lineHeight": 1.1, "letterSpacing": "-0.02em", "variantNumeric": "tabular-nums" },
      "Badge/Caps": { "family": "sans", "weight": 700, "size": "11px", "lineHeight": 1.0, "letterSpacing": "0.08em", "case": "uppercase" }
    }
  },
  "elevation": {
    "0": "none",
    "1-light": "0 1px 3px rgba(0,0,0,0.04), 0 4px 12px rgba(0,0,0,0.03)",
    "1-dark": "0 4px 20px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.05)",
    "2": "0 12px 32px rgba(0,0,0,0.08), 0 2px 6px rgba(0,0,0,0.04)",
    "glow-orange": "0 0 24px rgba(249,115,22,0.22), 0 0 48px rgba(249,115,22,0.10)",
    "glow-live": "0 0 16px rgba(22,163,74,0.35)"
  },
  "components": {
    "Button": {
      "variants": ["Primary", "Secondary", "Outline", "Ghost", "Live-CTA"],
      "sizes": {
        "Small": { "height": "36px", "paddingX": "14px", "paddingY": "8px", "gap": "6px", "radius": "sm" },
        "Medium": { "height": "44px", "paddingX": "20px", "paddingY": "10px", "gap": "8px", "radius": "sm" },
        "Large": { "height": "52px", "paddingX": "28px", "paddingY": "14px", "gap": "10px", "radius": "md" }
      },
      "states": ["Default", "Hover", "Active", "Focus", "Disabled", "Loading"]
    },
    "GameCard": {
      "status": ["Scheduled", "Live", "Final"],
      "mode": ["Compact", "Full", "Pickem-Interactive"],
      "logoSize": "36px",
      "minWidth": "340px",
      "maxWidth": "420px",
      "radius": "md",
      "padding": { "y": "16px", "x": "18px" }
    },
    "StandingsRow": {
      "tiers": ["Playoffs", "Play-In", "Lottery"],
      "columns": ["Rank", "Team", "W", "L", "PCT", "GB", "STRK", "L10"]
    },
    "FloatingIslandNav": {
      "top": "24px",
      "height": "56px",
      "radius": "full",
      "blur": "20px"
    }
  }
}
